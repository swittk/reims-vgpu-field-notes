+    /// Snapshot ordinary mapped guest RAM into a fresh internal upload allocation. This is
+    /// deliberately separate from read(): structured guest fields keep their ordered volatile
+    /// access/fault behavior. Pixel bytes need no per-word protocol semantics or atomic snapshot;
+    /// their external-write generation is checked around the entire upload by BackingResource.
+    ///
+    /// The caller retains its device/task guards and this map throughout the synchronous read.
+    /// Only a complete, single mapped RAM range is accepted, and the owned destination must be
+    /// disjoint. No source reference is created, so external guest storage is never represented
+    /// as an immutable Rust slice. Missing/cross-boundary/overlapping ranges are refused before
+    /// any write, preserving the caller's ordinary fallible mapped-buffer fallback.
+    pub(crate) fn read_upload(&self, physical: u64, dst: &mut [u8]) -> bool {
+        let source = self.virtual_address_for_physical(physical, dst.len().to_u64());
+        if source.is_null() {
+            return false;
+        }
+        if dst.is_empty() {
+            return true;
+        }
+        let first = source.addr();
+        let destination = dst.as_mut_ptr().addr();
+        let Some(source_end) = first.checked_add(dst.len()) else {
+            return false;
+        };
+        let Some(destination_end) = destination.checked_add(dst.len()) else {
+            return false;
+        };
+        if first < destination_end && destination < source_end {
+            return false;
+        }
+        // Raw guest accesses stay in the crate's single audited guest/ptr boundary. This
+        // layer proves ordinary map coverage, destination bounds and disjointness only.
+        crate::guest::GuestPtr::new(source).copy_upload_to(dst, DeathKind::MapReadFault);
+        true
+    }
