+/// An owned address reservation whose scatter-gather file mapping is needed only by a
+/// consumer that actually requests a contiguous CPU/device pointer. A decoder can copy into
+/// the canonical guest ranges without creating thousands of VMAs first. The complete backing
+/// file sequence is captured at construction, as for an eager alias: remaps of the source
+/// virtual addresses cannot silently change which files this view represents.
+///
+/// This owns no physical-page pins or guest objects. MAP_SHARED still follows hole punching
+/// and later writes to the files. The enclosing Memory owns both the inaccessible identity
+/// reservation and, once created, the separate immutable realized mapping.
+#[derive(Debug)]
+pub(super) struct DeferredView {
+    first: u64,
+    length: u64,
+    tail: u64,
+    read_only: bool,
+    pieces: Vec<files::Piece>,
+    ready: std::sync::OnceLock<Result<u64, KernReturn>>,
+}
+
+impl DeferredView {
+    /// Validate the same whole-page layout as a normal view and reserve its address, without
+    /// installing any per-page mappings. A non-readable reservation prevents accidental use
+    /// of an unprepared pointer; only tracking code may read its numerical address.
+    pub(super) fn new(
+        ranges: &[std::ops::Range<u64>],
+        length: u64,
+        tail: u64,
+        read_only: bool,
+    ) -> Option<Self> {
+        let page = page_size();
+        if length == 0 || length % page != 0 || tail % page != 0 {
+            return None;
+        }
+        let pieces = files::pieces_for_ranges(ranges, length)?;
+        if pieces.is_empty()
+            || pieces.iter().any(|p| {
+                p.length == 0
+                    || p.length % page != 0
+                    || p.at % page != 0
+                    || p.backing.offset % page != 0
+                    || libc::off_t::try_from(p.backing.offset).is_err()
+            })
+        {
+            return None;
+        }
+        let whole = length.checked_add(tail)?;
+        usize::try_from(whole).ok()?;
+        budget::admit(1, "a deferred surface view reservation");
+        let first = anonymous(None, whole, "a deferred surface view reservation").ok()?;
+        // SAFETY: the fresh unpublished reservation belongs exclusively to this constructor.
+        if unsafe { libc::mprotect(ptr(first), whole.to_usize(), libc::PROT_NONE) } != 0 {
+            // SAFETY: no pointer or mapping has escaped this constructor.
+            let _ = unsafe { libc::munmap(ptr(first), whole.to_usize()) };
+            return None;
+        }
+        Some(Self {
+            first,
+            length,
+            tail,
+            read_only,
+            pieces,
+            ready: std::sync::OnceLock::new(),
+        })
+    }
+
+    /// Its stable reserved identity, never a dereferenceable pointer. The real mapping is
+    /// published separately by realized() only after successful preparation.
+    pub(super) fn first(&self) -> u64 {
+        self.first
+    }
+
+    /// Whether the alias is already usable, without waiting for an ongoing construction.
+    pub(super) fn is_ready(&self) -> bool {
+        matches!(self.ready.get(), Some(Ok(_)))
+    }
+
+    /// An unpublished reservation (including one being prepared) can be shared by exact
+    /// file identity without waiting. No caller receives a dereferenceable pointer early.
+    pub(super) fn is_pending(&self) -> bool {
+        self.ready.get().is_none()
+    }
+
+    /// The actual view, once published. The reserved address is a metadata identity only;
+    /// no dereferenceable pointer is returned until this immutable realized address exists.
+    pub(super) fn realized(&self) -> Option<u64> {
+        self.ready
+            .get()
+            .and_then(|result| result.as_ref().ok().copied())
+    }
+
+    /// Materialize once using fresh address space, before exposing any CPU/device pointer.
+    /// Unlike MAP_FIXED over a long-lived reservation, the proven NOREPLACE path avoids
+    /// thousands of unnecessary unmap/replace operations. The full original file layout,
+    /// protections and lifetime are retained; this does not pin pages or copy their contents.
+    pub(super) fn prepare(&self) -> Result<(), KernReturn> {
