+
+/// A task reference held by a reply.
+///
+/// A non-last reference is released on the reply's delivery queue. A last reference is moved to a
+/// release queue, so [`Drop::drop`]'s completion drain cannot hold up the delivery queue that
+/// may already have the completing message queued behind this reply. The platform stays alive in
+/// both this holder and the task, and the release queue takes its own thread-service handle.
+struct ReplyTask<P: Platform> {
+    task: Option<Arc<RemoteTask<P>>>,
+    platform: Arc<P>,
+    /// The handshake keeps its separate endpoint reference after the task, as before.
+    endpoint_after_task: Option<Arc<Endpoint<P>>>,
+}
+
+impl<P: Platform> ReplyTask<P> {
+    /// A reply whose other endpoint reference is dropped before this holder.
+    fn new(task: Option<Arc<RemoteTask<P>>>, platform: Arc<P>) -> ReplyTask<P> {
+        ReplyTask {
+            task,
+            platform,
+            endpoint_after_task: None,
+        }
+    }
+
+    /// The handshake's task, followed by its separate endpoint reference.
+    fn handshake(
+        task: Arc<RemoteTask<P>>,
+        endpoint: Arc<Endpoint<P>>,
+        platform: Arc<P>,
+    ) -> ReplyTask<P> {
+        ReplyTask {
+            task: Some(task),
+            platform,
+            endpoint_after_task: Some(endpoint),
+        }
+    }
+
+    /// The task held by a handshake reply.
+    fn task(&self) -> &RemoteTask<P> {
+        self.task
+            .as_deref()
+            .expect("handshake reply without its task")
+    }
+
+    /// The separate endpoint held after the handshake's task.
+    fn endpoint_after_task(&self) -> &Endpoint<P> {
+        self.endpoint_after_task
+            .as_deref()
+            .expect("handshake reply without its endpoint")
+    }
+}
+
+/// A last handshake task and the endpoint reference that must be released after it.
+struct LastHandshakeTask<P: Platform> {
+    _task: RemoteTask<P>,
+    _endpoint: Arc<Endpoint<P>>,
+}
+
+impl<P: Platform> Drop for ReplyTask<P> {
+    fn drop(&mut self) {
+        let Some(task) = self.task.take() else {
+            return;
+        };
+        let Some(endpoint) = self.endpoint_after_task.take() else {
+            release_off_thread(self.platform.threads(), task);
+            return;
+        };
+
+        // `Arc::into_inner` consumes this reference atomically. If another reference wins a
+        // last-reference race, this one is released here and that other owner decides where the
+        // task drops. If this one wins, both releases move off the delivery queue, in their
+        // original task-then-endpoint order.
+        if let Some(task) = Arc::into_inner(task) {
+            release_off_thread(
+                self.platform.threads(),
+                Arc::new(LastHandshakeTask {
+                    _task: task,
+                    _endpoint: endpoint,
+                }),
+            );
+        }
+    }
+}
 
