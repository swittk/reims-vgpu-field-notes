+                                        offset: offsets[p],
+                                        bytes_per_row: pitches[p],
+                                        width: width as u32,
+                                        height: rows[p] as u32,
+                                    })
+                                    .collect(),
+                            };
+                            let (needed, plan) = layout.plane_copy_regions(&sources).unwrap();
+                            assert_eq!(needed, extent);
+                            let mut actual = vec![0xa5; extent + 7];
+                            for (offset, bytes) in &plan {
+                                actual[*offset..*offset + bytes.len()].copy_from_slice(bytes);
+                            }
+                            let mut expected = vec![0xa5; extent + 7];
+                            for p in 0..2 {
