+/// Copy prevalidated logical regions directly to the surface's existing canonical RAM.
+/// Unlike a writable alias lend, this path never faults a second set of page tables and
+/// never gathers untouched bytes. Regions are ordered, nonoverlapping, and bounded by
+/// `required_length`, which includes the complete destination layout (including padding).
+/// All checks finish before any byte changes. As with lends, callers must not nest a lend.
+#[cfg(target_os = "linux")]
+pub fn copy_surface_regions(
+    surface: &OsSurface,
+    required_length: usize,
+    regions: &[(usize, &[u8])],
+) -> Result<(), &'static str> {
+    let base = surface.base_address().as_ptr::<u8>().addr().to_u64();
+    if surface.protection_options() != 0 || base == 0 {
+        return Err("a protected surface, whose memory the CPU never reaches");
+    }
+    if gpu_read_only(surface) {
+        return Err("a surface the guest made read-only for its clients");
+    }
+    let made = recorded(surface, |made| (made.pages.clone(), made.offset));
+    let offset = made.as_ref().map_or(0, |(_, offset)| *offset);
+    let length = surface.alloc_size().saturating_sub(offset);
+    let length = usize::try_from(length).map_err(|_| "surface length exceeds host memory")?;
+    if required_length > length {
+        return Err("the copied layout exceeds the surface");
+    }
+    let mut previous_end = 0;
+    for &(at, bytes) in regions {
+        let end = at
+            .checked_add(bytes.len())
+            .ok_or("copied region overflow")?;
+        if at < previous_end || end > required_length {
+            return Err("invalid copied region order or bounds");
+        }
+        previous_end = end;
+    }
+    let held = match made {
+        Some((pages, _)) if !pages.is_empty() => {
+            in_runs(&pages, &(offset..offset + length.to_u64()))
+        }
+        _ => vec![
+            base..base
+                .checked_add(length.to_u64())
+                .ok_or("surface address overflow")?,
+        ],
+    };
+    let covered = held
+        .iter()
+        .try_fold(0usize, |total, range| {
+            let n = usize::try_from(range.end.checked_sub(range.start)?).ok()?;
+            total.checked_add(n)
+        })
+        .ok_or("surface page range overflow")?;
+    if covered != length {
+        return Err("the surface's canonical pages do not cover its allocation");
+    }
+    let _lend = LENDING.lock();
+    // A public safe copy can also be given bytes from overlapping host memory. Snapshot
+    // those inputs before changing anything, preserving memmove semantics across all regions
+    // and repeated destination pages. The ordinary decoder's staging buffer is disjoint.
+    let lowest = held.iter().map(|r| r.start).min().unwrap_or(0);
+    let highest = held.iter().map(|r| r.end).max().unwrap_or(0);
+    let overlaps = regions.iter().any(|(_, bytes)| {
+        let first = bytes.as_ptr().addr().to_u64();
+        let end = first.saturating_add(bytes.len().to_u64());
+        first < highest && lowest < end && held.iter().any(|r| first < r.end && r.start < end)
+    });
+    let snapshots = overlaps.then(|| {
+        regions
+            .iter()
+            .map(|(_, bytes)| bytes.to_vec())
+            .collect::<Vec<_>>()
+    });
+    let mut index = 0;
+    let mut run_start = 0usize;
+    for (region_index, &(at, input)) in regions.iter().enumerate() {
+        let bytes = snapshots
+            .as_ref()
+            .map_or(input, |copy| copy[region_index].as_slice());
+        let mut destination = at;
+        let mut source = 0;
+        while source < bytes.len() {
+            while destination >= run_start + (held[index].end - held[index].start).to_usize() {
+                run_start += (held[index].end - held[index].start).to_usize();
+                index += 1;
+            }
+            let run = &held[index];
+            let within = destination - run_start;
+            let count = (bytes.len() - source).min((run.end - run.start).to_usize() - within);
+            // SAFETY: the surface holds these canonical guest/owned pages exactly as in the
+            // existing lend path. All bounds and region order were checked above; LENDING
+            // serializes CPU writers. Each run is handled separately, so repeated physical
+            // pages never create simultaneous mutable slices. Overlapping inputs were copied.
+            unsafe {
+                std::ptr::copy_nonoverlapping(
+                    bytes.as_ptr().add(source),
+                    std::ptr::with_exposed_provenance_mut::<u8>(run.start.to_usize() + within),
+                    count,
+                );
+            }
+            destination += count;
+            source += count;
+        }
     }
