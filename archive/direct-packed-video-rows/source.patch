+#[test]
+fn packed_cpu_readback_uses_optional_scatter_or_unchanged_fallback() -> Result<(), WireError> {
+    for packed in [false, true] {
+        for scatter in [false, true] {
+            let guest = Guest::new();
+            guest
+                .backend
+                .frames
+                .packed_readback
+                .store(packed, Ordering::SeqCst);
+            guest
+                .memory
+                .scatter
+                .enabled
+                .store(scatter, Ordering::SeqCst);
+            guest.open()?;
+            assert_eq!(guest.start()?, NO_ERROR);
+            guest.seen();
+            guest.decode(1, 0, &sample(vec![0x41, 0x91], Some(format(AVCC))))?;
+            guest.seen_once(4);
+            assert_eq!(guest.emitted()[0].samples, Some([0x41, 0x41, 0, 0x91]));
+            let stats = &guest.memory.scatter;
+            assert_eq!(
+                stats.copied.load(Ordering::SeqCst),
+                usize::from(packed && scatter)
+            );
+            assert_eq!(
+                stats.lends.load(Ordering::SeqCst),
+                usize::from(!(packed && scatter))
+            );
+            assert_eq!(
+                stats.notifications.load(Ordering::SeqCst),
+                1,
+                "publish complete bytes exactly once"
+            );
+        }
+    }
+    Ok(())
+}
