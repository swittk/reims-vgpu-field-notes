+                            let rows = [height, height.div_ceil(2)];
+                            let pitches = [widths[0] + padding, widths[1] + padding];
+                            let offsets = [3, 3 + pitches[0] * rows[0] + 11];
+                            let extent = offsets[1] + pitches[1] * rows[1];
+                            let storage: Vec<Vec<u8>> = (0..2)
+                                .map(|p| {
+                                    let len = widths[p] * rows[p] - usize::from(shortened);
+                                    (0..len).map(|i| (17 + p * 61 + i * 7) as u8).collect()
+                                })
+                                .collect();
+                            let sources = [
+                                PlaneSource {
+                                    bytes: &storage[0],
+                                    bytes_per_row: widths[0],
+                                    rows: rows[0] as u32,
+                                },
+                                PlaneSource {
