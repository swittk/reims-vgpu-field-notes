+            return Ok(None);
+        };
+        let mut ranges = Vec::new();
+        let mut complete = true;
+        walker.visit_pages_in_range(
+            hold,
+            OnFault::Return,
+            page_address(page),
+            length,
+            &mut |_address, physical_page, _writable| {
+                let at = map.virtual_address_for_physical(page_address(physical_page), PAGE);
+                if at.is_null() {
+                    complete = false;
+                } else if let Some(end) = at.addr().to_u64().checked_add(PAGE) {
+                    ranges.push(at.addr().to_u64()..end);
+                } else {
+                    complete = false;
+                }
+                Ok(true)
+            },
+        )?;
+        Ok(complete.then(|| crate::external_writes::CanonicalRanges::new(ranges)))
     }
 
