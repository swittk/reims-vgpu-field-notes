+/// Completed external writes observed by cached legacy resource backings.
+pub mod external_writes {
+    //! Completed external writes to canonical host-RAM ranges, not their virtual aliases.
+    //! Standalone integration primitive; no GPU API, callbacks, pixels, or device identity.
+    use std::{
+        ops::Range,
+        sync::{
+            Arc, Mutex, Weak,
+            atomic::{AtomicU64, Ordering},
+        },
+    };
+    #[derive(Default)]
+    /// Process-local subscriptions to completed writes of canonical RAM ranges.
+    pub struct ExternalWrites {
+        watches: Mutex<Vec<Weak<WriteWatch>>>,
+    }
+    /// A weakly registered observation whose generation changes only for overlapping writes.
+    pub struct WriteWatch {
+        ranges: Vec<Range<u64>>,
+        generation: AtomicU64,
+    }
+    /// Sorted, disjoint half-open ranges of the same underlying RAM, computed once per binding.
+    #[derive(Clone)]
+    pub struct CanonicalRanges(Vec<Range<u64>>);
+    impl CanonicalRanges {
+        /// Normalize non-reversed canonical ranges, discarding empty intervals and merging overlaps.
+        pub fn new(mut ranges: Vec<Range<u64>>) -> Self {
+            assert!(
+                ranges.iter().all(|r| r.start <= r.end),
+                "reversed canonical RAM range"
+            );
+            ranges.retain(|r| r.start < r.end);
+            ranges.sort_unstable_by_key(|r| (r.start, r.end));
+            let mut merged: Vec<Range<u64>> = Vec::with_capacity(ranges.len());
+            for range in ranges {
+                if let Some(last) = merged.last_mut().filter(|r| range.start <= r.end) {
+                    last.end = last.end.max(range.end);
+                } else {
+                    merged.push(range);
+                }
+            }
+            Self(merged)
+        }
+        fn intersects(&self, other: &[Range<u64>]) -> bool {
+            let (mut i, mut j) = (0, 0);
+            while i < self.0.len() && j < other.len() {
+                let (a, b) = (&self.0[i], &other[j]);
+                if a.end <= b.start {
+                    i += 1;
+                } else if b.end <= a.start {
+                    j += 1;
+                } else {
+                    return true;
+                }
+            }
+            false
+        }
+    }
+    impl WriteWatch {
+        /// Capture BEFORE recording a prepare; acknowledge this value, never a later read.
+        pub fn generation(&self) -> u64 {
+            self.generation.load(Ordering::Acquire)
+        }
+        /// Whether a write followed the acknowledged snapshot; saturation remains conservatively dirty.
+        pub fn changed_since(&self, recorded: u64) -> bool {
+            let current = self.generation();
+            current == u64::MAX || current != recorded
+        }
+    }
+    impl ExternalWrites {
+        /// Call once for each retained backing binding; dropping the returned Arc unsubscribes.
+        pub fn watch(&self, ranges: CanonicalRanges) -> Arc<WriteWatch> {
+            let watch = Arc::new(WriteWatch {
+                ranges: ranges.0,
+                generation: AtomicU64::new(0),
+            });
+            let mut entries = self.watches.lock().unwrap_or_else(|e| e.into_inner());
+            entries.retain(|entry| entry.strong_count() != 0);
+            entries.push(Arc::downgrade(&watch));
+            watch
+        }
+        /// Publish only AFTER the CPU/device write completed and BEFORE notifying its consumer.
+        /// This records no memory, invokes no callbacks, and retains no resource or page binding.
+        pub fn completed_write(&self, written: &CanonicalRanges) {
+            if written.0.is_empty() {
+                return;
+            }
+            let mut entries = self.watches.lock().unwrap_or_else(|e| e.into_inner());
+            entries.retain(|entry| {
+                let Some(watch) = entry.upgrade() else {
+                    return false;
+                };
+                if written.intersects(&watch.ranges) {
+                    let _ = watch.generation.fetch_update(
+                        Ordering::Release,
+                        Ordering::Relaxed,
+                        |value| Some(value.saturating_add(1)),
+                    );
+                }
+                true
+            });
+        }
+    }
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+        #[test]
+        fn only_overlapping_canonical_pages_change() {
+            let registry = ExternalWrites::default();
+            let a = registry.watch(CanonicalRanges::new(vec![300..400, 100..200, 200..300]));
+            let b = registry.watch(CanonicalRanges::new(vec![900..1000]));
+            registry.completed_write(&CanonicalRanges::new(vec![200..210, 110..120]));
+            assert_eq!((a.generation(), b.generation()), (1, 0));
+            registry.completed_write(&CanonicalRanges::new(vec![0..100, 400..900]));
+            assert_eq!((a.generation(), b.generation()), (1, 0));
+        }
+        #[test]
+        fn write_during_prepare_is_not_acknowledged_accidentally() {
+            let registry = ExternalWrites::default();
+            let watch = registry.watch(CanonicalRanges::new(vec![100..200]));
+            let recorded = watch.generation();
+            registry.completed_write(&CanonicalRanges::new(vec![120..150]));
+            assert!(watch.changed_since(recorded));
+            let next = watch.generation();
+            assert!(!watch.changed_since(next));
+        }
+        #[test]
+        fn dead_subscriptions_do_not_retain_old_page_identity() {
+            let registry = ExternalWrites::default();
+            let old = registry.watch(CanonicalRanges::new(vec![100..200]));
+            let weak = Arc::downgrade(&old);
+            drop(old);
+            registry.completed_write(&CanonicalRanges::new(vec![100..200]));
+            assert!(weak.upgrade().is_none());
+            assert!(registry.watches.lock().unwrap().is_empty());
+            let new = registry.watch(CanonicalRanges::new(vec![100..200]));
+            assert_eq!(new.generation(), 0);
+        }
+        #[test]
+        fn concurrent_completed_writes_are_not_lost() {
+            let registry = Arc::new(ExternalWrites::default());
+            let watch = registry.watch(CanonicalRanges::new(vec![100..200]));
+            std::thread::scope(|scope| {
+                for _ in 0..2 {
+                    let registry = &registry;
+                    scope.spawn(move || {
+                        for _ in 0..100 {
+                            registry.completed_write(&CanonicalRanges::new(vec![110..120]));
+                        }
+                    });
+                }
+            });
+            assert_eq!(watch.generation(), 200);
+        }
+    }
+
+    /// Process registry; addresses are canonical host RAM, never alternate aliases.
+    pub fn process() -> &'static ExternalWrites {
+        static REGISTRY: std::sync::OnceLock<ExternalWrites> = std::sync::OnceLock::new();
+        REGISTRY.get_or_init(ExternalWrites::default)
+    }
+}
